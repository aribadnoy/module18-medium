
body {
    font-family: Arial, sans-serif;
    background-color: #f0f0f0;
    text-align: center;
}

h1 {
    color: blue;
    margin-top: 50px;
}

/* Perspektiva 3D */
.container {
    perspective: 600px;
    margin-top: 100px;
}

/* Dizajnimi i kutisë */
.box {
    width: 200px;
    height: 150px;
    background-color: lightblue;
    margin: auto;
    padding: 20px;
    border-radius: 15px;

    /* Tranzicioni */
    transition: transform 1s;
}

/* Efekti 3D gjatë hover */
.box:hover {
    transform: rotateY(180deg);
    background-color: lightgreen;
}

